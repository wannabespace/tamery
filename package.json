{
  "private": true,
  "description": "AI-powered tool for working with Postgres, MySQL, MSSQL, ClickHouse and SQLite.",
  "homepage": "https://tamery.app",
  "author": {
    "name": "Wannabe Space, LLC",
    "email": "wannabespace.llc@gmail.com"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky && bun scripts/sync-pnpm-versions.ts && bun scripts/setup-dev.ts",
    "postinstall": "pnpm run portless:start",
    "portless:start": "portless proxy start --tld app",
    "portless:stop": "portless proxy stop",
    "x": "bun scripts/run-script.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "icons": "resize-images icons.config.ts",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:start": "turbo run test:start",
    "dev": "bun scripts/run-script.ts dev",
    "build:todesktop": "turbo run @tamery/desktop#build:todesktop",
    "build:cli": "turbo run tamery#build",
    "publish:cli": "cd apps/cli && pnpm publish --access public --no-git-checks",
    "drizzle:generate": "cd packages/db && pnpm run drizzle:generate",
    "drizzle:migrate": "pnpm --filter @tamery/db run drizzle:migrate",
    "check-types": "tsc --noEmit && turbo run check-types",
    "update": "taze -r -I major",
    "docker:start": "docker compose -f docker-compose.dev.yml up -d",
    "docker:stop": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@shadcn/lint": "catalog:",
    "@tamery/configs": "workspace:*",
    "@tamery/resize": "workspace:*",
    "@types/bun": "catalog:",
    "cross-env": "catalog:",
    "husky": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "playwright": "catalog:",
    "portless": "catalog:",
    "tailwindcss": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@12.15.0"
}
