{
  "$schema": "./node_modules/@todesktop/cli/schemas/schema.json",
  "id": "2610172p48e2t",
  "appId": "com.wannabespace.tamery",
  "icon": "./resources/icon-1024x1024.png",
  "appPath": ".",
  "schemaVersion": 1,
  "nodeVersion": "24.6.0",
  "appBuilderLibVersion": "26.15.3",
  "packageManager": "pnpm",
  "pnpmVersion": "12.15.0",
  "copyright": "Copyright © 2024 Wannabe Space, LLC",
  "appFiles": ["dist-electron/**"],
  "filesForDistribution": ["!**/node_modules/oracledb/build/**"],
  "fuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "uploadSizeLimit": 80,
  "bundleWorkspacePackages": {
    "enabled": true
  },
  "appProtocolScheme": [
    "tamery",
    "clickhouse",
    "mariadb",
    "mongodb",
    "mongodb+srv",
    "mssql",
    "mysql",
    "oracle",
    "postgres",
    "postgresql",
    "sqlserver"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "./resources/macos-icon.icon"
  },
  "windows": {
    "publisherName": ["Todesktop Limited"]
  },
  "linux": {
    "category": "Development"
  }
}
