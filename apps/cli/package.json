{
  "name": "@tamery/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Tamery CLI: run the Tamery web app's queries on your own computer.",
  "keywords": [
    "cli",
    "clickhouse",
    "database",
    "mssql",
    "mysql",
    "oracle",
    "postgres",
    "sql",
    "sqlite",
    "tamery"
  ],
  "homepage": "https://tamery.app",
  "bugs": {
    "url": "https://github.com/wannabespace/tamery/issues"
  },
  "author": {
    "name": "Wannabe Space, LLC",
    "email": "wannabespace.llc@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannabespace/tamery.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check-types": "bun check",
    "dev": "bun --watch src/index.ts bridge",
    "tamery": "bun src/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@clickhouse/client": "catalog:",
    "@libsql/client": "catalog:",
    "@mongodb-js/shell-bson-parser": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@tamery/api": "workspace:*",
    "@tamery/configs": "workspace:*",
    "@tamery/connection": "workspace:*",
    "@tamery/query-proxy": "workspace:*",
    "@tamery/shared": "workspace:*",
    "@types/bun": "catalog:",
    "arktype": "catalog:",
    "better-result": "catalog:",
    "mongodb": "catalog:",
    "mssql": "catalog:",
    "mysql2": "catalog:",
    "oracledb": "catalog:",
    "pg": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:"
  }
}
