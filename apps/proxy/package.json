{
  "name": "@tamery/proxy",
  "type": "module",
  "scripts": {
    "dev": "portless run cross-env NODE_ENV=development bun --watch run ./index.ts",
    "start": "cross-env NODE_ENV=production bun run ./index.ts",
    "check-types": "bun check",
    "test:start": "cross-env NODE_ENV=test bun --env-file=.env.test run ./index.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@duckdb/node-api": "catalog:",
    "@libsql/client": "catalog:",
    "@mongodb-js/socksv5": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/ratelimit": "catalog:",
    "@orpc/server": "catalog:",
    "@tamery/api": "workspace:*",
    "@tamery/connection": "workspace:*",
    "@tamery/mongo": "workspace:*",
    "@tamery/query-proxy": "workspace:*",
    "@tamery/shared": "workspace:*",
    "arktype": "catalog:",
    "better-result": "catalog:",
    "cross-env": "catalog:",
    "hono": "catalog:",
    "lru-cache": "catalog:",
    "mongodb": "catalog:",
    "mssql": "catalog:",
    "mysql2": "catalog:",
    "oracledb": "catalog:",
    "pg": "catalog:",
    "socks": "catalog:",
    "ssh-config": "catalog:",
    "ssh2": "catalog:",
    "ua-parser-js": "catalog:"
  },
  "devDependencies": {
    "@tamery/configs": "workspace:*",
    "better-auth": "catalog:"
  },
  "portless": "proxy.local.tamery"
}
