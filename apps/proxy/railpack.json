{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        {
          "src": ".",
          "dest": "."
        },
        "pnpm install --frozen-lockfile --prefer-offline --filter @tamery/proxy... --filter ."
      ]
    },
    "build": {
      "commands": [
        {
          "src": ".",
          "dest": "."
        },
        "pnpm exec turbo run check-types --filter=@tamery/proxy"
      ],
      "variables": {
        "pnpm_config_verify_deps_before_run": "false"
      }
    }
  },
  "deploy": {
    "startCommand": "cd apps/proxy && pnpm run start",
    "variables": {
      "pnpm_config_verify_deps_before_run": "false"
    }
  }
}
