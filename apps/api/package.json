{
  "name": "@tamery/api",
  "type": "module",
  "scripts": {
    "dev": "portless run cross-env NODE_ENV=development bun --watch run ./index.ts",
    "start": "cross-env NODE_ENV=production bun run --preload ./lib/unwrap-secrets.ts ./index.ts",
    "rotate:connection-keys": "bun run --preload ./lib/unwrap-secrets.ts ./scripts/rotate/connection-keys.ts",
    "rotate:encryption-secret": "bun run --preload ./lib/unwrap-secrets.ts ./scripts/rotate/encryption-secret.ts",
    "rotate:user-key-secret": "bun run --preload ./lib/unwrap-secrets.ts ./scripts/rotate/user-key-secret.ts",
    "check-types": "tsc",
    "test:start": "cross-env NODE_ENV=test bun --env-file=.env.test drizzle-kit migrate && cross-env NODE_ENV=test bun --env-file=.env.test run ./index.ts",
    "better-auth:generate": "cross-env NODE_ENV=development pnpx auth generate --output ../../packages/db/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/core": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@exalabs/ai-sdk": "catalog:",
    "@infisical/sdk": "catalog:",
    "@octokit/rest": "catalog:",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@orpc/publisher": "catalog:",
    "@orpc/ratelimit": "catalog:",
    "@orpc/server": "catalog:",
    "@react-email/components": "catalog:",
    "@tamery/ai": "workspace:*",
    "@tamery/connection": "workspace:*",
    "@tamery/db": "workspace:*",
    "@tamery/shared": "workspace:*",
    "@upstash/context7-tools-ai-sdk": "catalog:",
    "ai": "catalog:",
    "ai-retry": "catalog:",
    "arktype": "catalog:",
    "better-auth": "catalog:",
    "better-auth-harmony": "catalog:",
    "better-result": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "memoza": "catalog:",
    "nanoid": "catalog:",
    "permix": "catalog:",
    "pg": "catalog:",
    "posthog-node": "catalog:",
    "react": "catalog:",
    "redis": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:",
    "ua-parser-js": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tamery/configs": "workspace:*",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "catalog:"
  },
  "portless": "api.local.tamery"
}
