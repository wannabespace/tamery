{
  "extends": "@tamery/configs/ts/base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./*"]
    },
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.types",
    "strictNullChecks": true,
    "types": [
      "@types/bun",
      "@better-auth/core/db/internal",
      "@simplewebauthn/server"
    ]
  }
}
